        }
      },
      "extractionState": "manual"
    },
    "The listener stays on loopback, so the forwarded port is not exposed to the LAN.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听器仅绑定回环地址，因此转发端口不会暴露给局域网。"
          }
        }
      },
      "extractionState": "manual"
    },
    "The local port is allocated automatically and remains loopback-only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地端口会自动分配，并且仅限回环访问。"
          }
        }
      },
      "extractionState": "manual"
    },
    "The previous Gateway Token is the default Unified API key.": {
