    "The internal loopback key is generated from Keychain into the helper's private configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内部回环密钥由钥匙串生成到辅助程序的私有配置中。"
          }
        }
      },
      "extractionState": "manual"
    },
    "The key is stored in Keychain and is never written to ModelMoor configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥存储在钥匙串中，绝不会写入 ModelMoor 配置。"
          }
        }
      },
      "extractionState": "manual"
    },
    "The key is stored in Keychain and is never written to the ModelMoor configuration file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
